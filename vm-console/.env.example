# Where VictoriaMetrics lives. The browser never sees this value.
#
# Single node:
VM_URL=http://localhost:8428
#
# Cluster (vmselect, tenant 0):
# VM_URL=http://vmselect:8481/select/0/prometheus
#
# Public playground, useful for a first run with real data:
# VM_URL=https://play.victoriametrics.com/select/0/prometheus

# Optional auth, sent from the server only. Use one or the other.
# VM_BEARER_TOKEN=
# VM_BASIC_AUTH=user:password

# Give up on a query after this long.
VM_TIMEOUT_MS=60000

# Where vmalert lives, for the Alerts tab (rule groups + active alerts).
# Leave unset if you don't run vmalert — the tab just shows a connection error.
VMALERT_URL=http://localhost:8880

# Optional auth, same idea as VM_BEARER_TOKEN/VM_BASIC_AUTH above.
# VMALERT_BEARER_TOKEN=
# VMALERT_BASIC_AUTH=user:password

VMALERT_TIMEOUT_MS=15000

# --- docker-compose profiles only, not read by the app itself -------------
# docker compose interpolates ${VAR} from this file too, separately from how
# the app reads its own runtime env above. Only needed for:
#   docker compose --profile cloudflare-auth up -d --build
# See the `cloudflared`/`cloudflare-jwt-keys`/`vmauth-cloudflare` service
# comments in docker-compose.yml for the full setup.
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_TEAM_DOMAIN=
# CLOUDFLARE_ACCESS_AUD=
